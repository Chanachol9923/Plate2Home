{
  "name": "plate2home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project db",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:coverage": "vitest run --project unit --coverage",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:provinces": "node scripts/gen-provinces-sql.mjs --check",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:contrast && npm run check:provinces && npm test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/db/types.gen.ts",
    "gen:provinces": "node scripts/gen-provinces-sql.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "fast-check": "4.10.2",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "supabase": "2.118.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
