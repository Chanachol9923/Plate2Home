# Plate2Home environment variables.
# Copy to .env.local for development. Never commit real values.
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put a secret in one.
# Everything else is server-only and is checked by `npm run check:secrets` after a build.

# --- App -------------------------------------------------------------------------------
# Public origin, used for the Origin-header check on writes and for links in notifications.
APP_ORIGIN=http://localhost:3000

# --- Supabase --------------------------------------------------------------------------
# `npx supabase start` prints local values. Use the NEW key format (sb_publishable_/sb_secret_);
# legacy anon/service_role JWT keys are deprecated by the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key: only used by the admin login page. RLS gives it no access to data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: bypasses RLS. Server only (lib/db/server.ts).
SUPABASE_SECRET_KEY=

# --- Cloudflare Turnstile ----------------------------------------------------------------
# Defaults are Cloudflare's public TEST keys (always pass; only accept the dummy token).
# Production: create a widget in the Cloudflare dashboard and use its real keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Web Push (VAPID) --------------------------------------------------------------------
# Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Email (optional, needs a verified domain with Resend) -------------------------------
FEATURE_EMAIL=false
RESEND_API_KEY=
EMAIL_FROM=

# --- Secrets for server jobs -------------------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. >= 32 random chars.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
# Keys the daily-rotating HMAC used to hash IP addresses. >= 32 random chars.
IP_HASH_SECRET=
# Set to false once the site is dormant AND empty, so the Supabase project can pause.
CRON_ENABLED=true

# --- Access log. LEGAL-TODO(access-log): keep disabled until legal advice -----------------
ACCESS_LOG_ENABLED=false
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACCESS_LOG_KEY=
ACCESS_LOG_KEY_VERSION=1
ACCESS_LOG_RETENTION_DAYS=90

# --- Feature flags -----------------------------------------------------------------------
# In-browser plate detection/recognition (Phase 6). Manual entry always works.
NEXT_PUBLIC_FEATURE_OCR=false

# --- Tests -------------------------------------------------------------------------------
# When set, database tests run against this Postgres (e.g. local `supabase start`)
# instead of the in-process PGlite fallback.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
